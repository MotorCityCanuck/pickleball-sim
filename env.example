# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pickleball
DATABASE_ECHO=false

# Simulation runtime
SIMULATION_VERSION=0.1.0
SIMULATION_DEFAULT_SEED=1
SIMULATION_INITIAL_HISTORICAL_MONTHS=12
SIMULATION_CONFIG_PROFILE=default

# Optional: pin a specific configuration profile version.
# Leave blank to use the latest active version.
SIMULATION_CONFIG_VERSION=
