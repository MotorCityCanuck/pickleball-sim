# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pickleball
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# Application
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Simulation Defaults
DEFAULT_MASTER_SEED=42
DEFAULT_SIMULATION_NAME=NAPA_Olympic_Analytics_v1
DEFAULT_TARGET_PLAYERS=250000
DEFAULT_HISTORICAL_BATCH_COUNT=12

# Monthly Generation
DEFAULT_MONTHLY_PLAYER_GROWTH_RATE=0.02
DEFAULT_MONTHLY_MATCHES_PER_PLAYER_MEAN=8.0

# Rating Configuration
DEFAULT_INITIAL_RATING_MEAN=1500.0
DEFAULT_INITIAL_RATING_STD_DEV=200.0
DEFAULT_RATING_NOISE_STD_DEV=75.0
DEFAULT_K_FACTOR_NEW_PLAYER=48.0
DEFAULT_K_FACTOR_ESTABLISHED=24.0
DEFAULT_K_FACTOR_ELITE=16.0

# Match Scheduling
DEFAULT_WEEKEND_CONCENTRATION_BIAS=1.75
DEFAULT_SATURDAY_WEIGHT=2.25
DEFAULT_SUNDAY_WEIGHT=1.85

# Team Formation
DEFAULT_TEAM_PERSISTENCE_RECREATIONAL=0.72
DEFAULT_TEAM_PERSISTENCE_COMPETITIVE=0.88

# Export Configuration
DEFAULT_EXPORT_FORMAT=parquet
DEFAULT_EXPORT_COMPRESSION=snappy
EXPORT_BATCH_ON_COMPLETION=true

# Validation
DEFAULT_VALIDATION_STRICTNESS=standard
DEFAULT_WEEKEND_CONCENTRATION_MIN=0.40
DEFAULT_WEEKEND_CONCENTRATION_MAX=0.60

# Web UI (for later)
WEB_HOST=0.0.0.0
WEB_PORT=8000
WEB_RELOAD=true
